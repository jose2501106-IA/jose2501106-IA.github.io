{#- Imagen para compartir (1200 × 630), una por idioma. La genera scripts/imagenes.py con Chromium.
    Estilo A · Laboratorio: fondo claro, tinta, un solo acento petróleo, reglas finas. -#}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<style>
  @font-face { font-family: "Schibsted Grotesk"; font-style: normal; font-weight: 400 700; src: url("{{ base }}assets/fuentes/schibsted-grotesk.woff2") format("woff2"); }
  @font-face { font-family: "Fragment Mono"; font-style: normal; font-weight: 400; src: url("{{ base }}assets/fuentes/fragment-mono-400.woff2") format("woff2"); }
  :root { --fondo: #F7F8F7; --tinta: #12181B; --gris: #4A575C; --regla: #DCE2E3; --acento: #0F5E66;
          --sans: "Schibsted Grotesk", Arial, sans-serif; --mono: "Fragment Mono", ui-monospace, monospace; }
  * { box-sizing: border-box; margin: 0; }
  html, body { width: 1200px; height: 630px; }
  body { position: relative; overflow: hidden; background: var(--fondo); color: var(--tinta); font-family: var(--sans); font-synthesis: none; }

  .texto { position: absolute; left: 64px; top: 64px; width: 652px; display: flex; flex-direction: column; }
  .kicker { font: 400 17px/24px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--acento); }
  h1 { margin-top: 22px; font: 700 104px/.98 var(--sans); letter-spacing: -0.035em; }
  .sub { margin-top: 30px; font: 500 32px/1.25 var(--sans); letter-spacing: -0.01em; text-wrap: balance; }
  .bajada { margin-top: 14px; font: 400 20px/1.45 var(--sans); color: var(--gris); text-wrap: balance; }

  .foto { position: absolute; right: 64px; top: 40px; width: 360px; display: flex; flex-direction: column; gap: 10px; }
  .foto img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: 2px; background: #E9EDEE; }
  .foto p { padding-top: 10px; border-top: 1px solid var(--regla); display: flex; gap: 10px; font: 400 14px/20px var(--mono); color: var(--gris); }
  .foto b { font-weight: 400; color: var(--tinta); }

  .franja { position: absolute; left: 0; right: 0; bottom: 0; height: 64px; padding: 0 64px; display: flex; align-items: center; justify-content: space-between;
            background: #FFFFFF; border-top: 1px solid var(--regla); }
  .sitio { display: flex; align-items: center; gap: 16px; font: 400 18px/1 var(--mono); color: var(--tinta); }
  .sitio svg { display: block; flex: none; color: var(--acento); }
  .idiomas { font: 400 15px/1 var(--mono); letter-spacing: .04em; color: var(--gris); }
</style>
</head>
<body>
  <div class="texto">
    <p class="kicker">{{ kicker }}</p>
    <h1>{{ nombre[0] }}<br>{{ nombre[1] }}</h1>
    <p class="sub">{{ sub }}</p>
    <p class="bajada">{{ bajada|replace(" · ", "&nbsp;· "|safe) }}</p>
  </div>
  <figure class="foto">
    <img src="{{ base }}assets/img/retrato-864.webp" alt="">
    <p><b>Fig. 1</b><span>{{ nombre_corto }}, {{ ubicacion }}</span></p>
  </figure>
  <div class="franja">
    <span class="sitio">
      <svg width="48" height="18" viewBox="0 0 32 12" fill="none" aria-hidden="true"><circle cx="5" cy="6" r="5" fill="currentColor"/><path d="M10 6 H24" stroke="currentColor" stroke-width="1.5"/><circle cx="28" cy="6" r="3.25" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>jose2501106-ia.github.io{{ ruta }}</span>
    </span>
    <span class="idiomas">{{ idiomas }}</span>
  </div>
</body>
</html>
