{#- Página 404 bilingüe (estilo A · Laboratorio). GitHub Pages la sirve en cualquier dirección que no exista
    (por ejemplo, enlaces viejos), así que todas las rutas van desde la raíz del dominio. Se genera con scripts/generar.py. -#}
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ s.pagina_404.titulo.es }} · {{ s.sitio.nombre }}</title>
<meta name="theme-color" content="#FFFFFF">
<link rel="icon" href="{{ raiz }}favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ raiz }}favicon-32.png" sizes="32x32" type="image/png">
<link rel="preload" href="{{ raiz }}assets/fuentes/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ raiz }}assets/css/sitio.css?v={{ version }}">
</head>
<body class="pagina-error">
<header class="cabecera">
  <div class="cabecera__in">
    <a class="marca" href="{{ raiz }}">
      <svg class="marca__nodo" width="32" height="12" viewBox="0 0 32 12" aria-hidden="true" focusable="false"><circle cx="5" cy="6" r="5" fill="currentColor"/><path d="M10 6H24" stroke="currentColor" stroke-width="1.5"/><circle cx="28" cy="6" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      <span class="marca__sigla">{{ s.sitio.marca }}</span>
      <span class="marca__sep" aria-hidden="true"></span>
      <span class="marca__nombre">{{ s.sitio.nombre }}</span>
    </a>
    <div class="idioma" role="group" aria-label="Idioma · Language">
      <a href="{{ raiz }}" lang="es" hreflang="es">ES</a>
      <span aria-hidden="true">/</span>
      <a href="{{ raiz }}en/" lang="en" hreflang="en">EN</a>
    </div>
  </div>
</header>
<main class="error">
  <p class="etiqueta etiqueta--acento">Error 404</p>
  <h1 class="error__tit">{{ s.pagina_404.titulo.es }}</h1>
  <p class="error__txt">{{ s.pagina_404.texto.es }}</p>
  <p class="error__en" lang="en"><b>{{ s.pagina_404.titulo.en }}.</b> {{ s.pagina_404.texto.en }}</p>
  <div class="acciones">
    <a class="btn btn--pri" href="{{ raiz }}">{{ s.pagina_404.inicio.es }}</a>
    <a class="btn btn--sec" href="{{ raiz }}en/" lang="en" hreflang="en">{{ s.pagina_404.inicio.en }}</a>
    <a class="enlace" href="{{ raiz }}{{ s.cv.archivo.es }}" download type="application/pdf">{{ s.cv.boton.es }}</a>
  </div>
</main>
<footer class="pie">
  <div class="pie__in"><p class="pie__frase">{{ s.pie.frase.es }}</p><p>© {{ s.sitio.anio }} {{ s.sitio.nombre_completo }}</p></div>
</footer>
</body>
</html>
