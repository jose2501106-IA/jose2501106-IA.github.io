{#- Página 404 bilingüe. GitHub Pages la sirve en cualquier dirección que no exista (por ejemplo, enlaces viejos),
    así que todas las rutas van desde la raíz del dominio. Se genera con scripts/generar.py. -#}
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ s.pagina_404.titulo.es }} · {{ s.sitio.nombre }}</title>
<meta name="theme-color" content="#0B1F4A">
<link rel="icon" href="{{ raiz }}favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ raiz }}favicon-32.png" sizes="32x32" type="image/png">
<link rel="preload" href="{{ raiz }}assets/fuentes/space-mono-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ raiz }}assets/css/sitio.css?v={{ version }}">
</head>
<body>
<div class="lienzo">
<nav class="nav" aria-label="Principal">
  <div class="nav__in">
    <a class="marca" href="{{ raiz }}">{{ s.sitio.marca }}<span class="marca__sep"> / </span>{{ s.ui.marca_sub.es }}</a>
    <div class="idioma idioma--derecha" role="group" aria-label="Idioma · Language">
      <a href="{{ raiz }}" lang="es" hreflang="es">ES</a>
      <a href="{{ raiz }}en/" lang="en" hreflang="en">EN</a>
    </div>
  </div>
</nav>
<main class="hoja hoja--404">
  <div class="hoja__meta">{{ s.ui.hoja.es }} 404</div>
  <div class="error">
    <p class="error__cod" aria-hidden="true">404</p>
    <div class="error__textos">
      <h1>{{ s.pagina_404.titulo.es }}</h1>
      <p>{{ s.pagina_404.texto.es }}</p>
      <p class="error__en" lang="en"><b>{{ s.pagina_404.titulo.en }}.</b> {{ s.pagina_404.texto.en }}</p>
      <div class="botones">
        <a class="btn btn--pri" href="{{ raiz }}">{{ s.pagina_404.inicio.es }}</a>
        <a class="btn btn--sec" href="{{ raiz }}en/" lang="en" hreflang="en">{{ s.pagina_404.inicio.en }}</a>
        <a class="btn btn--ter" href="{{ raiz }}{{ s.cv.archivo.es }}" download type="application/pdf">{{ s.cv.boton.es }}</a>
      </div>
    </div>
  </div>
</main>
<footer class="pie">
  <div class="pie__in"><div class="pie__frase">{{ s.pie.frase.es }}</div><div>© {{ s.sitio.anio }} {{ s.sitio.nombre_completo }}</div></div>
</footer>
</div>
</body>
</html>
